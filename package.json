{
  "name": "orangecypress",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "cy:open": "node open.js",
    "cy:open:chrome": "npx cypress open --browser chrome",
    "cy:open:edge": "npx cypress open --browser edge",
    "cy:headed": "npx cypress run --headed --browser chrome",
    "cy:headed:edge": "npx cypress run --headed --browser edge",
    "cy:run": "npx cypress run",
    "cy:run:headed": "npx cypress run --headed",
    "cy:run:chrome": "npx cypress run --browser chrome",
    "test": "npx cypress run --env allure=true",
    "test:allure": "npx cypress run --env allure=true",
    "allure:report": "npx allure generate allure-results --clean -o allure-report",
    "allure:open": "npx allure open allure-report",
    "cy:ci": "npx cypress run --browser chrome --env allure=true"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "OrangeHRM automated tests using Cypress",
  "devDependencies": {
    "@cypress/xpath": "^2.0.3",
    "@shelex/cypress-allure-plugin": "^2.41.2",
    "allure-commandline": "^2.43.0",
    "cross-env": "^10.1.0",
    "cypress": "^12.17.4"
  },
  "dependencies": {
    "xlsx": "^0.18.5"
  }
}
